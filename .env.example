NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/auth/select-role

AUTH_SECRET=replace_with_npx_auth_secret
AUTH_TRUST_HOST=true
ECDLINK_FALLBACK_ADMIN_EMAIL=admin@ecdlink.co.za
ECDLINK_FALLBACK_ADMIN_PASSWORD=replace_this_password

DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require
CLERK_WEBHOOK_SECRET=whsec_REPLACE_ME
USE_MOCK_DATA=false

# Private Supabase Storage (server-only; never prefix the service-role key with NEXT_PUBLIC_)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_service_role_key
SUPABASE_STORAGE_BUCKET=ecdlink-private
SUPABASE_SIGNED_URL_TTL_SECONDS=300

# Enterprise email delivery (defaults to safe no-op delivery)
EMAIL_PROVIDER=noop
EMAIL_FROM=
EMAIL_REPLY_TO=
APP_BASE_URL=http://localhost:3000
RESEND_API_KEY=
EMAIL_REQUEST_TIMEOUT_MS=10000
EMAIL_MAX_ATTEMPTS=3
READINESS_CHECK_TIMEOUT_MS=5000

# The deployment platform sets this automatically. Production startup validation requires "production".
NODE_ENV=development
