generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  SUPER_ADMIN
  ECDLINK_STAFF
  ECD_CENTRE
  SUPPLIER
  DONOR
  FUNDING_ORGANISATION
  SYSTEM
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  ARCHIVED
}

enum NotificationModule {
  FUNDING
  COMPLIANCE
  PROCUREMENT
  MEMBERSHIP
  SUPPLIERS
  CENTRES
  PARTNERS
  PLATFORM
}

enum NotificationType {
  FUNDING_APPLICATION_SUBMITTED
  FUNDING_APPLICATION_CLARIFICATION_REQUESTED
  FUNDING_APPLICATION_APPROVED
  FUNDING_APPLICATION_REJECTED
  FUNDING_APPLICATION_REVIEWER_ASSIGNED
  FUNDING_DOCUMENT_RESUBMISSION_REQUESTED
  FUNDING_DOCUMENT_VERIFIED
  FUNDING_MANUAL_COMMUNICATION
  PLATFORM_GENERAL
}

enum NotificationDeliveryPreference {
  EMAIL
  IN_APP
  BOTH
  NONE
}

enum FundingCommunicationType {
  CLARIFICATION_REQUESTED
  APPLICATION_APPROVED
  APPLICATION_REJECTED
  DOCUMENT_VERIFIED
  DOCUMENT_RESUBMISSION
  MANUAL
  EMAIL
}

enum EcdlinkStaffDepartment {
  OPERATIONS
  CENTRE_SUPPORT
  COMPLIANCE
  FAMILY_SUPPORT
  PROCUREMENT
  EVENTS
  FUNDING
  TRAINING
  FINANCE
  MONITORING_AND_EVALUATION
  MANAGEMENT
}

enum EcdlinkStaffEmploymentStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
}

enum CentreUserRole {
  PRINCIPAL
  OWNER
  ADMINISTRATOR
  PRACTITIONER
  FINANCE
  VOLUNTEER
  READ_ONLY
}

enum OwnershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
  REMOVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum RegistrationStatus {
  REGISTERED
  IN_PROGRESS
  NOT_REGISTERED
}

enum MembershipStatus {
  ACTIVE
  PENDING
  EXPIRED
  OVERDUE
  CANCELLED
}

enum ParticipationStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum ComplianceStatus {
  COMPLIANT
  ATTENTION
  ACTION_REQUIRED
}

enum ReadinessStatus {
  READY
  IN_PROGRESS
  NEEDS_ATTENTION
}

enum ActivityType {
  PROFILE
  MEMBERSHIP
  PROCUREMENT
  COMPLIANCE
  FUNDING
  NOTE
}

enum DocumentStatus {
  UPLOADED
  MISSING
  EXPIRED
  EXPIRING_SOON
  VERIFIED
  REJECTED
}

enum VerificationStatus {
  PENDING
  PENDING_REVIEW
  VERIFIED
  REJECTED
  REQUIRES_RESUBMISSION
}

enum OrderStatus {
  DRAFT
  SUBMITTED
  AWAITING_APPROVAL
  APPROVED
  REJECTED
  PACKED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum DeliveryStatus {
  PENDING
  PACKED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  FAILED
}

enum ProcurementCycleStatus {
  DRAFT
  OPEN
  CLOSED
  PROCESSING
  DELIVERED
  ARCHIVED
}

enum StockStatus {
  AVAILABLE
  LOW_STOCK
  OUT_OF_STOCK
  BACK_ORDER
  DISCONTINUED
  UNKNOWN
}

enum InvoiceStatus {
  DRAFT
  GENERATED
  SENT
  PAID
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  NOT_PAID
  FAILED
  REFUNDED
}

enum FundingApplicationStatus {
  DRAFT
  IN_PROGRESS
  READY
  SUBMITTED
  UNDER_REVIEW
  CLARIFICATION_REQUESTED
  APPROVED
  REJECTED
  WITHDRAWN
}

enum FundingChecklistStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETE
  WAIVED
}

enum SupplierUserRole {
  OWNER
  ADMINISTRATOR
  SALES
  FINANCE
  LOGISTICS
  CATALOGUE_MANAGER
  READ_ONLY
}

enum SupplierOwnershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
  REMOVED
}

enum SupplierDocumentStatus {
  MISSING
  UPLOADED
  PENDING_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
  EXPIRING_SOON
}

enum SupplierQuotationStatus {
  DRAFT
  REQUESTED
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  EXPIRED
  WITHDRAWN
}

enum PartnerUserRole {
  OWNER
  ADMINISTRATOR
  PROGRAMME_MANAGER
  FINANCE
  MONITORING_EVALUATION
  VIEWER
}

enum PartnerOwnershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
  REMOVED
}

enum MessageParticipantType {
  USER
  CENTRE
  SUPPLIER
  DONOR
  FUNDING_ORGANISATION
  ECDLINK
}

enum IntelligenceQueryStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum IntelligenceInsightSeverity {
  INFORMATION
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IntelligenceInsightStatus {
  NEW
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  DISMISSED
  EXPIRED
}

enum IntelligenceRecommendationStatus {
  SUGGESTED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  DISMISSED
}

enum IntelligenceDraftStatus {
  DRAFT
  REVIEWED
  ACCEPTED
  REJECTED
  CONVERTED
}

model User {
  id                          String                         @id @default(cuid())
  clerkUserId                 String                         @unique
  email                       String?
  firstName                   String?
  lastName                    String?
  phone                       String?
  role                        UserRole
  roleId                      String?
  status                      UserStatus                     @default(ACTIVE)
  lastLoginAt                 DateTime?
  createdAt                   DateTime                       @default(now())
  updatedAt                   DateTime                       @updatedAt
  roleRecord                  Role?                          @relation(fields: [roleId], references: [id])
  centreUsers                 CentreUser[]
  supplierUsers               SupplierUser[]
  donorUsers                  DonorUser[]
  fundingUsers                FundingOrganisationUser[]
  ecdlinkStaffProfile         EcdlinkStaffProfile?
  assignedStaffCentres        EcdlinkStaffCentreAssignment[] @relation("StaffCentreAssignmentsAssignedBy")
  sessions                    Session[]
  sentInvitations             Invitation[]                   @relation("InvitationSender")
  acceptedInvitations         Invitation[]                   @relation("InvitationAcceptedUser")
  uploadedFiles               FileAsset[]                    @relation("UploadedFiles")
  submittedDocuments          ComplianceDocument[]           @relation("SubmittedComplianceDocuments")
  verifiedDocuments           ComplianceDocument[]           @relation("VerifiedDocuments")
  rejectedDocuments           ComplianceDocument[]           @relation("RejectedComplianceDocuments")
  auditLogs                   AuditLog[]
  receivedNotifications       Notification[]                 @relation("ReceivedNotifications")
  createdNotifications        Notification[]                 @relation("CreatedNotifications")
  notificationPreferences     NotificationPreference[]
  fundingReviewerNotes        FundingReviewerNote[]           @relation("FundingReviewerNotes")
  fundingCommunicationsAuthored FundingCommunication[]         @relation("FundingCommunicationsAuthored")
  fundingCommunicationsReceived FundingCommunication[]         @relation("FundingCommunicationsReceived")
  sentMessages                Message[]                      @relation("SentMessages")
  membershipPayments          MembershipPayment[]
  intelligenceQueries         IntelligenceQuery[]
  intelligenceRecommendations IntelligenceRecommendation[]
  intelligenceProposalDrafts  IntelligenceProposalDraft[]
  intelligenceBudgetDrafts    IntelligenceBudgetDraft[]

  @@index([email])
  @@index([role, status])
}

model Role {
  id                  String              @id @default(cuid())
  key                 UserRole            @unique
  name                String
  description         String?
  system              Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  users               User[]
  permissions         RolePermission[]
  intelligenceQueries IntelligenceQuery[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model EcdlinkStaffProfile {
  id                String                         @id @default(cuid())
  userId            String                         @unique
  employeeNumber    String                         @unique
  firstName         String
  lastName          String
  jobTitle          String
  department        EcdlinkStaffDepartment
  employmentStatus  EcdlinkStaffEmploymentStatus   @default(ACTIVE)
  managerId         String?
  phoneNumber       String?
  workEmail         String                         @unique
  startDate         DateTime?
  profilePhoto      String?
  isActive          Boolean                        @default(true)
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt
  user              User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  manager           EcdlinkStaffProfile?           @relation("StaffManager", fields: [managerId], references: [id])
  directReports     EcdlinkStaffProfile[]          @relation("StaffManager")
  centreAssignments EcdlinkStaffCentreAssignment[]

  @@index([department, employmentStatus])
  @@index([managerId])
}

model EcdlinkStaffCentreAssignment {
  id             String              @id @default(cuid())
  staffProfileId String
  centreId       String
  assignmentRole String
  assignedAt     DateTime            @default(now())
  assignedBy     String?
  isPrimary      Boolean             @default(false)
  isActive       Boolean             @default(true)
  notes          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  staffProfile   EcdlinkStaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  centre         EcdCentre           @relation(fields: [centreId], references: [id], onDelete: Cascade)
  assignedByUser User?               @relation("StaffCentreAssignmentsAssignedBy", fields: [assignedBy], references: [id])

  @@unique([staffProfileId, centreId, assignmentRole])
  @@index([centreId, isActive])
  @@index([staffProfileId, isPrimary])
}

model EcdCentre {
  id                          String                         @id @default(cuid())
  centreName                  String
  slug                        String                         @unique
  registrationStatus          RegistrationStatus             @default(IN_PROGRESS)
  npoNumber                   String?
  dbeRegistrationStatus       String?
  partialCareStatus           String?
  physicalAddress             String?
  suburb                      String?
  area                        String?
  region                      String?
  province                    String?
  postalCode                  String?
  latitude                    Decimal?                       @db.Decimal(10, 7)
  longitude                   Decimal?                       @db.Decimal(10, 7)
  contactPerson               String?
  phone                       String?
  email                       String?
  principalName               String?
  numberOfChildren            Int?
  numberOfStaff               Int?
  membershipStatus            MembershipStatus               @default(PENDING)
  procurementStatus           ParticipationStatus            @default(PENDING)
  complianceStatus            ComplianceStatus               @default(ATTENTION)
  fundingReadinessStatus      ReadinessStatus                @default(IN_PROGRESS)
  notes                       String?
  createdAt                   DateTime                       @default(now())
  updatedAt                   DateTime                       @updatedAt
  archivedAt                  DateTime?
  users                       CentreUser[]
  photos                      CentrePhoto[]
  centreNotes                 CentreNote[]
  activities                  CentreActivity[]
  memberships                 Membership[]
  complianceDocuments         ComplianceDocument[]
  fundingProfiles             FundingProfile[]
  procurementOrders           ProcurementOrder[]
  impactProjects              ImpactProject[]
  partnershipRequests         PartnershipRequest[]
  sponsorshipCommitments      SponsorshipCommitment[]
  impactReports               ImpactReport[]
  partnerBookmarks            PartnerBookmark[]
  partnerEngagements          PartnerEngagement[]
  messageThreads              MessageThread[]
  notifications               Notification[]
  intelligenceInsights        IntelligenceInsight[]
  intelligenceRecommendations IntelligenceRecommendation[]
  intelligenceProposalDrafts  IntelligenceProposalDraft[]
  intelligenceBudgetDrafts    IntelligenceBudgetDraft[]
  invitations                 Invitation[]
  staffAssignments            EcdlinkStaffCentreAssignment[]

  @@index([slug])
  @@index([area, region, province])
}

model CentreUser {
  id          String          @id @default(cuid())
  centreId    String
  userId      String
  role        CentreUserRole  @default(READ_ONLY)
  title       String?
  status      OwnershipStatus @default(ACTIVE)
  permissions String[]        @default([])
  isPrimary   Boolean         @default(false)
  joinedAt    DateTime        @default(now())
  removedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  centre      EcdCentre       @relation(fields: [centreId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([centreId, userId])
  @@index([userId, status])
  @@index([centreId, role])
}

model CentrePhoto {
  id         String     @id @default(cuid())
  centreId   String
  title      String
  tone       String?
  fileId     String?
  uploadedAt DateTime   @default(now())
  centre     EcdCentre  @relation(fields: [centreId], references: [id], onDelete: Cascade)
  file       FileAsset? @relation(fields: [fileId], references: [id])
}

model CentreNote {
  id        String    @id @default(cuid())
  centreId  String
  author    String
  body      String
  createdAt DateTime  @default(now())
  centre    EcdCentre @relation(fields: [centreId], references: [id], onDelete: Cascade)
}

model CentreActivity {
  id          String       @id @default(cuid())
  centreId    String
  title       String
  description String
  type        ActivityType
  createdAt   DateTime     @default(now())
  centre      EcdCentre    @relation(fields: [centreId], references: [id], onDelete: Cascade)
}

model Membership {
  id                  String              @id @default(cuid())
  centreId            String
  membershipYear      Int
  annualFee           Decimal             @db.Decimal(12, 2)
  startDate           DateTime
  expiryDate          DateTime
  renewalReminderDate DateTime
  renewalDate         DateTime?
  status              MembershipStatus    @default(PENDING)
  paymentStatus       PaymentStatus       @default(NOT_PAID)
  amountDue           Decimal             @db.Decimal(12, 2)
  amountPaid          Decimal             @default(0) @db.Decimal(12, 2)
  balance             Decimal             @db.Decimal(12, 2)
  notes               String?
  cancelledAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  centre              EcdCentre           @relation(fields: [centreId], references: [id], onDelete: Cascade)
  invoices            MembershipInvoice[]
  payments            MembershipPayment[]
  receipts            MembershipReceipt[]

  @@unique([centreId, membershipYear])
  @@index([membershipYear, status, paymentStatus])
}

model MembershipInvoice {
  id           String        @id @default(cuid())
  membershipId String
  invoiceNo    String        @unique
  amount       Decimal       @db.Decimal(12, 2)
  status       InvoiceStatus @default(GENERATED)
  issuedAt     DateTime      @default(now())
  dueAt        DateTime?
  fileId       String?
  membership   Membership    @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  file         FileAsset?    @relation(fields: [fileId], references: [id])
}

model MembershipPayment {
  id               String              @id @default(cuid())
  membershipId     String
  receivedByUserId String?
  amount           Decimal             @db.Decimal(12, 2)
  status           PaymentStatus       @default(PENDING)
  paymentMethod    String?
  receiptReference String?
  paidAt           DateTime?
  createdAt        DateTime            @default(now())
  membership       Membership          @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  receivedBy       User?               @relation(fields: [receivedByUserId], references: [id])
  receipts         MembershipReceipt[]
}

model MembershipReceipt {
  id           String             @id @default(cuid())
  membershipId String
  paymentId    String?
  receiptNo    String             @unique
  amount       Decimal            @db.Decimal(12, 2)
  issuedAt     DateTime           @default(now())
  fileId       String?
  membership   Membership         @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  payment      MembershipPayment? @relation(fields: [paymentId], references: [id])
  file         FileAsset?         @relation(fields: [fileId], references: [id])
}

model ComplianceRequirement {
  id                 String               @id @default(cuid())
  type               String               @unique
  name               String?
  code               String?              @unique
  description        String?
  category           String?
  required           Boolean              @default(true)
  requiresExpiryDate Boolean              @default(false)
  acceptedFileTypes  String[]             @default([])
  maxFileSize        Int?
  active             Boolean              @default(true)
  displayOrder       Int                  @default(0)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  documents          ComplianceDocument[]
}

model ComplianceDocument {
  id                    String                 @id @default(cuid())
  centreId              String
  requirementId         String?
  fileId                String?
  documentNumber        String?
  documentType          String
  issueDate             DateTime?
  expiryDate            DateTime?
  status                DocumentStatus         @default(MISSING)
  verificationStatus    VerificationStatus     @default(PENDING_REVIEW)
  submittedByUserId     String?
  submittedAt           DateTime?
  verifiedByUserId      String?
  verifiedAt            DateTime?
  rejectedByUserId      String?
  rejectedAt            DateTime?
  rejectionReason       String?
  adminNotes            String?
  reminderDate          DateTime?
  replacementDocumentId String?
  archivedAt            DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  centre                EcdCentre              @relation(fields: [centreId], references: [id], onDelete: Cascade)
  requirement           ComplianceRequirement? @relation(fields: [requirementId], references: [id])
  file                  FileAsset?             @relation(fields: [fileId], references: [id])
  submittedBy           User?                  @relation("SubmittedComplianceDocuments", fields: [submittedByUserId], references: [id])
  verifiedBy            User?                  @relation("VerifiedDocuments", fields: [verifiedByUserId], references: [id])
  rejectedBy            User?                  @relation("RejectedComplianceDocuments", fields: [rejectedByUserId], references: [id])
  replacementDocument   ComplianceDocument?    @relation("ComplianceDocumentReplacement", fields: [replacementDocumentId], references: [id])
  replacedDocuments     ComplianceDocument[]   @relation("ComplianceDocumentReplacement")

  @@index([centreId, status, verificationStatus])
  @@index([requirementId, expiryDate])
}

model FundingProfile {
  id                   String                      @id @default(cuid())
  centreId             String
  readinessScore       Int                         @default(0)
  status               FundingApplicationStatus    @default(DRAFT)
  readinessStatus      ReadinessStatus             @default(IN_PROGRESS)
  proposalReady        Boolean                     @default(false)
  budgetReady          Boolean                     @default(false)
  beneficiaryListReady Boolean                     @default(false)
  supportingDocsReady  Boolean                     @default(false)
  missingRequirements  String[]                    @default([])
  recommendedActions   String[]                    @default([])
  adminNotes           String?
  lastAssessmentDate   DateTime?
  nextReviewDate       DateTime?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  centre               EcdCentre                   @relation(fields: [centreId], references: [id], onDelete: Cascade)
  projects             FundingProject[]
  checklistItems       FundingChecklistItem[]
  supportingDocuments  FundingSupportingDocument[]
  reminders            FundingReminder[]

  @@unique([centreId])
  @@index([status, readinessScore])
}

model FundingProject {
  id                       String                   @id @default(cuid())
  fundingProfileId         String
  title                    String
  slug                     String?                  @unique
  opportunityType          String?
  funderType               String?
  summary                  String?
  objective                String?
  problemStatement         String?
  expectedOutcomes         String[]                 @default([])
  requiredItems            String[]                 @default([])
  requestedAmount          Decimal                  @db.Decimal(12, 2)
  amountSecured            Decimal                  @default(0) @db.Decimal(12, 2)
  fundingGap               Decimal                  @default(0) @db.Decimal(12, 2)
  beneficiaries            Int?
  startDate                DateTime?
  endDate                  DateTime?
  status                   FundingApplicationStatus @default(DRAFT)
  visibility               String                   @default("Internal")
  approvedForPartnerPortal Boolean                  @default(false)
  approvedAt               DateTime?
  archivedAt               DateTime?
  createdByUserId          String?
  approvedByUserId         String?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  profile                  FundingProfile           @relation(fields: [fundingProfileId], references: [id], onDelete: Cascade)
  applications             FundingApplication[]
  beneficiaryLists         BeneficiaryList[]
  budgets                  Budget[]
  proposals                FundingProposal[]
  impactProjects           ImpactProject[]

  @@index([status, opportunityType])
}

model FundingApplication {
  id                         String                   @id @default(cuid())
  projectId                  String
  fundingCallId              String?
  fundingOrganisationId      String?
  applicationNumber          String                   @unique
  requestedAmount            Decimal                  @default(0) @db.Decimal(12, 2)
  approvedAmount             Decimal?                 @db.Decimal(12, 2)
  readinessScoreAtSubmission Int?
  submissionMethod           String?
  externalReference          String?
  status                     FundingApplicationStatus @default(DRAFT)
  submittedAt                DateTime?
  decidedAt                  DateTime?
  decisionDate               DateTime?
  rejectionReason            String?
  adminNotes                 String?
  notes                      String?
  createdByUserId            String?
  reviewedByUserId           String?
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  project                    FundingProject           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fundingCall                FundingCall?             @relation(fields: [fundingCallId], references: [id])
  fundingOrganisation        FundingOrganisation?     @relation(fields: [fundingOrganisationId], references: [id])
  assessments                FundingAssessment[]
  reminders                  FundingReminder[]
  reviewerNotes              FundingReviewerNote[]
  communications             FundingCommunication[]

  @@index([status, submittedAt])
  @@index([fundingCallId])
}

model FundingReviewerNote {
  id            String   @id @default(cuid())
  applicationId String
  authorUserId  String
  body          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?
  application   FundingApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  author        User @relation("FundingReviewerNotes", fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([applicationId, deletedAt, createdAt])
  @@index([authorUserId, createdAt])
}

model FundingCommunication {
  id              String @id @default(cuid())
  applicationId   String
  type            FundingCommunicationType
  authorUserId    String?
  recipientUserId String?
  title           String
  body            String
  metadata        Json?
  sourceEventKey  String? @unique
  createdAt       DateTime @default(now())
  application     FundingApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  author          User? @relation("FundingCommunicationsAuthored", fields: [authorUserId], references: [id], onDelete: SetNull)
  recipient       User? @relation("FundingCommunicationsReceived", fields: [recipientUserId], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
  @@index([recipientUserId, createdAt])
  @@index([type, createdAt])
}

model BeneficiaryList {
  id               String         @id @default(cuid())
  projectId        String
  name             String
  count            Int
  beneficiaryType  String?
  reportingPeriod  String?
  boysCount        Int?
  girlsCount       Int?
  ageGroupSummary  Json?
  disabilityCount  Int?
  notes            String?
  fileId           String?
  createdByUserId  String?
  verifiedByUserId String?
  verifiedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  project          FundingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  file             FileAsset?     @relation(fields: [fileId], references: [id])
}

model Budget {
  id               String         @id @default(cuid())
  projectId        String
  title            String
  currency         String         @default("ZAR")
  total            Decimal        @db.Decimal(12, 2)
  requestedAmount  Decimal        @default(0) @db.Decimal(12, 2)
  coFundingAmount  Decimal        @default(0) @db.Decimal(12, 2)
  version          Int            @default(1)
  status           String         @default("Draft")
  createdByUserId  String?
  reviewedByUserId String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  project          FundingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items            BudgetItem[]
}

model BudgetItem {
  id                   String     @id @default(cuid())
  budgetId             String
  label                String
  category             String?
  description          String?
  quantity             Int        @default(1)
  unit                 String?
  unitCost             Decimal    @db.Decimal(12, 2)
  lineTotal            Decimal    @db.Decimal(12, 2)
  frequency            String?
  justification        String?
  supplierId           String?
  quotationFileAssetId String?
