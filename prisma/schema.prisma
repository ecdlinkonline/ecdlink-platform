  engagements          PartnerEngagement[]
}

model ImpactProjectNeed {
  id                 String        @id @default(cuid())
  projectId          String
  needType           String
  itemName           String
  description        String?
  quantity           Int           @default(1)
  unit               String?
  estimatedUnitCost  Decimal       @default(0) @db.Decimal(12, 2)
  estimatedTotalCost Decimal       @default(0) @db.Decimal(12, 2)
  priority           String        @default("Medium")
  supportType        String        @default("Financial")
  fulfilledQuantity  Int           @default(0)
  status             String        @default("Open")
  supplierId         String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  project            ImpactProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  supplier           Supplier?     @relation(fields: [supplierId], references: [id])
}

model SponsorshipCommitment {
  id                     String              @id @default(cuid())
  partnershipRequestId   String?
  donorOrganisationId    String
  centreId               String
  impactProjectId        String?
  commitmentType         String
  committedAmount        Decimal?            @db.Decimal(12, 2)
  committedItems         Json?
  committedServices      Json?
  commitmentDate         DateTime            @default(now())
  expectedFulfilmentDate DateTime?
  fulfilledDate          DateTime?
  commitmentStatus       String              @default("Proposed")
  referenceNumber        String              @unique
  notes                  String?
  createdByUserId        String?
  approvedByUserId       String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  request                PartnershipRequest? @relation(fields: [partnershipRequestId], references: [id])
  donor                  DonorOrganisation   @relation(fields: [donorOrganisationId], references: [id], onDelete: Cascade)
  centre                 EcdCentre           @relation(fields: [centreId], references: [id])
  project                ImpactProject?      @relation(fields: [impactProjectId], references: [id])

  @@index([donorOrganisationId, commitmentStatus])
}

model ProjectUpdate {
  id                   String        @id @default(cuid())
  impactProjectId      String
  title                String
  updateDate           DateTime
  summary              String
  fullUpdate           String?
  progressPercentage   Int           @default(0)
  beneficiariesReached Int?
  amountUsed           Decimal?      @db.Decimal(12, 2)
  milestoneStatus      String        @default("Planned")
  visibility           String        @default("Private")
  createdByUserId      String?
  approvedByUserId     String?
  approvedAt           DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  project              ImpactProject @relation(fields: [impactProjectId], references: [id], onDelete: Cascade)
}

model PartnerBookmark {
  id                  String            @id @default(cuid())
  donorOrganisationId String
  userId              String?
  centreId            String?
  impactProjectId     String?
  impactReportId      String?
  bookmarkType        String
  createdAt           DateTime          @default(now())
  donor               DonorOrganisation @relation(fields: [donorOrganisationId], references: [id], onDelete: Cascade)
  centre              EcdCentre?        @relation(fields: [centreId], references: [id])
  project             ImpactProject?    @relation(fields: [impactProjectId], references: [id])
  report              ImpactReport?     @relation(fields: [impactReportId], references: [id])

  @@unique([donorOrganisationId, centreId, impactProjectId, impactReportId])
}

model PartnerEngagement {
  id                  String            @id @default(cuid())
  donorOrganisationId String
  userId              String?
  centreId            String?
  impactProjectId     String?
  impactReportId      String?
  action              String
  engagementDate      DateTime          @default(now())
  metadata            Json?
  donor               DonorOrganisation @relation(fields: [donorOrganisationId], references: [id], onDelete: Cascade)
  centre              EcdCentre?        @relation(fields: [centreId], references: [id])
  project             ImpactProject?    @relation(fields: [impactProjectId], references: [id])
  report              ImpactReport?     @relation(fields: [impactReportId], references: [id])

  @@index([donorOrganisationId, action])
}

model FundingOrganisation {
  id                          String                       @id @default(cuid())
  name                        String
  slug                        String                       @unique
  type                        String?
  status                      String                       @default("Active")
  users                       FundingOrganisationUser[]
  calls                       FundingCall[]
  applications                FundingApplication[]
  intelligenceInsights        IntelligenceInsight[]
  intelligenceRecommendations IntelligenceRecommendation[]
}

model FundingOrganisationUser {
  id                    String              @id @default(cuid())
  fundingOrganisationId String
  userId                String
  isPrimary             Boolean             @default(false)
  organisation          FundingOrganisation @relation(fields: [fundingOrganisationId], references: [id], onDelete: Cascade)
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([fundingOrganisationId, userId])
}

model FundingCall {
  id                        String               @id @default(cuid())
  fundingOrganisationId     String
  referenceNumber           String?              @unique
  title                     String
  type                      String?
  description               String?
  focusAreas                String[]             @default([])
  eligibleRegions           String[]             @default([])
  eligibleOrganisationTypes String[]             @default([])
  minimumAmount             Decimal?             @db.Decimal(12, 2)
  maximumAmount             Decimal?             @db.Decimal(12, 2)
  applicationMethod         String?
  contactEmail              String?
  externalUrl               String?
  requiredDocuments         String[]             @default([])
  featured                  Boolean              @default(false)
  opensAt                   DateTime?
  closesAt                  DateTime?
  publishedAt               DateTime?
  archivedAt                DateTime?
  status                    String               @default("Open")
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  organisation              FundingOrganisation  @relation(fields: [fundingOrganisationId], references: [id], onDelete: Cascade)
  assessments               FundingAssessment[]
  applications              FundingApplication[]

  @@index([type, status])
}

model FundingAssessment {
  id                    String              @id @default(cuid())
  fundingCallId         String
  fundingApplicationId  String?
  assessorUserId        String?
  fundingOrganisationId String?
  eligibilityScore      Int?
  complianceScore       Int?
  projectQualityScore   Int?
  budgetScore           Int?
  impactScore           Int?
  totalScore            Int?
  score                 Int?
  status                String              @default("Under Review")
  recommendation        String?
  notes                 String?
  assessedAt            DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  call                  FundingCall         @relation(fields: [fundingCallId], references: [id], onDelete: Cascade)
  application           FundingApplication? @relation(fields: [fundingApplicationId], references: [id])
}

model Notification {
  id              String             @id @default(cuid())
  userId          String?
  recipientUserId String?
  actorUserId     String?
  centreId        String?
  module          NotificationModule @default(PLATFORM)
  type            NotificationType   @default(PLATFORM_GENERAL)
  title           String
  body            String
  href             String?
  metadata         Json?
  readAt           DateTime?
  createdAt        DateTime           @default(now())
  recipient        User?              @relation("ReceivedNotifications", fields: [recipientUserId], references: [id], onDelete: Cascade)
  actor            User?              @relation("CreatedNotifications", fields: [actorUserId], references: [id], onDelete: SetNull)
  centre           EcdCentre?         @relation(fields: [centreId], references: [id])

  @@index([recipientUserId, readAt, createdAt])
  @@index([recipientUserId, module, createdAt])
  @@index([recipientUserId, type, createdAt])
  @@index([centreId, createdAt])
}

model NotificationPreference {
  id        String                         @id @default(cuid())
  userId    String
  type      NotificationType
  delivery  NotificationDeliveryPreference @default(BOTH)
  createdAt DateTime                       @default(now())
  updatedAt DateTime                       @updatedAt
  user      User                           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
}

model MessageThread {
  id                   String              @id @default(cuid())
  subject              String
  threadType           String?
  donorOrganisationId  String?
  centreId             String?
  partnershipRequestId String?
  createdAt            DateTime            @default(now())
  messages             Message[]
  donor                DonorOrganisation?  @relation(fields: [donorOrganisationId], references: [id])
  centre               EcdCentre?          @relation(fields: [centreId], references: [id])
  partnershipRequest   PartnershipRequest? @relation(fields: [partnershipRequestId], references: [id])

  @@index([donorOrganisationId, centreId])
}

model Message {
  id           String                 @id @default(cuid())
  threadId     String
  senderUserId String?
  senderType   MessageParticipantType
  body         String
  createdAt    DateTime               @default(now())
  thread       MessageThread          @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender       User?                  @relation("SentMessages", fields: [senderUserId], references: [id])
}

model FileAsset {
  id                         String                      @id @default(cuid())
  storageProvider            String
  storageKey                 String
  originalFilename           String
  mimeType                   String
  fileSize                   Int
  checksum                   String?
  uploadedByUserId           String?
  createdAt                  DateTime                    @default(now())
  uploadedBy                 User?                       @relation("UploadedFiles", fields: [uploadedByUserId], references: [id])
  centrePhotos               CentrePhoto[]
  membershipInvoices         MembershipInvoice[]
  membershipReceipts         MembershipReceipt[]
  complianceDocuments        ComplianceDocument[]
  supplierDocuments          SupplierDocument[]
  beneficiaryLists           BeneficiaryList[]
  fundingSupportingDocuments FundingSupportingDocument[]
  budgetItemQuotations       BudgetItem[]                @relation("BudgetItemQuotationFiles")
  supplierInvoices           SupplierInvoice[]
  supplierPaymentProofs      SupplierPayment[]           @relation("SupplierPaymentProofFiles")
  invoices                   Invoice[]
  proofs                     ProofOfDelivery[]
  impactReports              ImpactReport[]
  intelligenceReports        IntelligenceResponse[]
}

model IntelligenceQuery {
  id               String                  @id @default(cuid())
  userId           String
  roleId           String?
  organisationType String?
  organisationId   String?
  queryText        String
  queryCategory    String
  queryIntent      String?
  status           IntelligenceQueryStatus @default(PENDING)
  createdAt        DateTime                @default(now())
  completedAt      DateTime?
  failedAt         DateTime?
  errorMessage     String?
  metadata         Json?
  responseId       String?
  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role             Role?                   @relation(fields: [roleId], references: [id])
  response         IntelligenceResponse?

  @@index([userId, status, createdAt])
  @@index([queryCategory, status])
  @@index([organisationType, organisationId])
}

model IntelligenceResponse {
  id                  String                        @id @default(cuid())
  queryId             String                        @unique
  responseType        String
  title               String
  summary             String?
  answerText          String
  structuredData      Json?
  confidenceLevel     Int                           @default(70)
  dataFreshnessDate   DateTime                      @default(now())
  generatedAt         DateTime                      @default(now())
  generatedBy         String                        @default("Rules Engine")
  requiresHumanReview Boolean                       @default(true)
  warnings            String[]                      @default([])
  recommendedActions  Json?
  reportFileAssetId   String?
  proposalDraftId     String?
  budgetDraftId       String?
  query               IntelligenceQuery             @relation(fields: [queryId], references: [id], onDelete: Cascade)
  sourceReferences    IntelligenceSourceReference[]
  reportFileAsset     FileAsset?                    @relation(fields: [reportFileAssetId], references: [id])
  proposalDraft       IntelligenceProposalDraft?    @relation(fields: [proposalDraftId], references: [id])
  budgetDraft         IntelligenceBudgetDraft?      @relation(fields: [budgetDraftId], references: [id])
}

model IntelligenceSourceReference {
  id           String               @id @default(cuid())
  responseId   String
  sourceType   String
  sourceId     String
  sourceLabel  String
  module       String
  relationship String?
  createdAt    DateTime             @default(now())
  response     IntelligenceResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@index([sourceType, sourceId])
}

model IntelligenceInsight {
  id                    String                       @id @default(cuid())
  insightType           String
  title                 String
  summary               String
  severity              IntelligenceInsightSeverity  @default(INFORMATION)
  priority              Int                          @default(3)
  targetRole            UserRole?
  centreId              String?
  supplierId            String?
  donorOrganisationId   String?
  fundingOrganisationId String?
  relatedEntityType     String?
  relatedEntityId       String?
  status                IntelligenceInsightStatus    @default(NEW)
  detectedAt            DateTime                     @default(now())
  acknowledgedAt        DateTime?
  resolvedAt            DateTime?
  expiresAt             DateTime?
  metadata              Json?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  centre                EcdCentre?                   @relation(fields: [centreId], references: [id])
  supplier              Supplier?                    @relation(fields: [supplierId], references: [id])
  donorOrganisation     DonorOrganisation?           @relation(fields: [donorOrganisationId], references: [id])
  fundingOrganisation   FundingOrganisation?         @relation(fields: [fundingOrganisationId], references: [id])
  recommendations       IntelligenceRecommendation[]

  @@index([targetRole, status, severity])
  @@index([centreId, status])
  @@index([supplierId, status])
  @@index([donorOrganisationId, status])
  @@index([fundingOrganisationId, status])
}

model IntelligenceRecommendation {
  id                    String                           @id @default(cuid())
  insightId             String?
  userId                String?
  centreId              String?
  supplierId            String?
  donorOrganisationId   String?
  fundingOrganisationId String?
  recommendationType    String
  title                 String
  description           String
  rationale             String?
  priority              Int                              @default(3)
  actionRoute           String?
  status                IntelligenceRecommendationStatus @default(SUGGESTED)
  generatedAt           DateTime                         @default(now())
  acknowledgedAt        DateTime?
  completedAt           DateTime?
  metadata              Json?
  insight               IntelligenceInsight?             @relation(fields: [insightId], references: [id])
  user                  User?                            @relation(fields: [userId], references: [id])
  centre                EcdCentre?                       @relation(fields: [centreId], references: [id])
  supplier              Supplier?                        @relation(fields: [supplierId], references: [id])
  donorOrganisation     DonorOrganisation?               @relation(fields: [donorOrganisationId], references: [id])
  fundingOrganisation   FundingOrganisation?             @relation(fields: [fundingOrganisationId], references: [id])

  @@index([status, priority])
  @@index([centreId, status])
}

model IntelligencePromptTemplate {
  id                 String   @id @default(cuid())
  role               UserRole
  category           String
  title              String
  promptText         String
  description        String?
  active             Boolean  @default(true)
  displayOrder       Int      @default(0)
  requiresPermission String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([role, active, displayOrder])
}

model IntelligenceProposalDraft {
  id                      String                  @id @default(cuid())
  centreId                String
  projectId               String?
  fundingCallId           String?
  title                   String
  executiveSummary        String
  organisationBackground  String?
  problemStatement        String?
  projectDescription      String?
  objectives              String[]                @default([])
  expectedOutcomes        String[]                @default([])
  implementationPlan      String?
  monitoringAndEvaluation String?
  sustainability          String?
  risks                   String?
  conclusion              String?
  status                  IntelligenceDraftStatus @default(DRAFT)
  generatedFromData       Json?
  requiresHumanReview     Boolean                 @default(true)
  createdByUserId         String?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  centre                  EcdCentre               @relation(fields: [centreId], references: [id])
  createdBy               User?                   @relation(fields: [createdByUserId], references: [id])
  responses               IntelligenceResponse[]

  @@index([centreId, status])
}

model IntelligenceBudgetDraft {
  id                  String                        @id @default(cuid())
  centreId            String
  projectId           String?
  title               String
  currency            String                        @default("ZAR")
  requestedAmount     Decimal                       @default(0) @db.Decimal(12, 2)
  estimatedTotal      Decimal                       @default(0) @db.Decimal(12, 2)
  status              IntelligenceDraftStatus       @default(DRAFT)
  assumptions         String[]                      @default([])
  requiresHumanReview Boolean                       @default(true)
  createdByUserId     String?
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt
  centre              EcdCentre                     @relation(fields: [centreId], references: [id])
  createdBy           User?                         @relation(fields: [createdByUserId], references: [id])
  items               IntelligenceBudgetDraftItem[]
  responses           IntelligenceResponse[]

  @@index([centreId, status])
}

model IntelligenceBudgetDraftItem {
  id                String                  @id @default(cuid())
  budgetDraftId     String
  category          String
  description       String
  quantity          Int                     @default(1)
  unit              String?
  estimatedUnitCost Decimal                 @default(0) @db.Decimal(12, 2)
  estimatedTotal    Decimal                 @default(0) @db.Decimal(12, 2)
  justification     String?
  sourceType        String?
  sourceId          String?
  budgetDraft       IntelligenceBudgetDraft @relation(fields: [budgetDraftId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  before      Json?
  after       Json?
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User?    @relation(fields: [actorUserId], references: [id])

  @@index([action, entityType])
  @@index([actorUserId, createdAt])
}

model Session {
  id             String    @id @default(cuid())
  userId         String
  clerkSessionId String?   @unique
  provider       String
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  revokedAt      DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lastSeenAt])
}

model Invitation {
  id               String           @id @default(cuid())
  email            String
  token            String           @unique
  invitedRole      UserRole
  centreId         String?
  centreRole       CentreUserRole?
  permissions      String[]         @default([])
  invitedByUserId  String?
  acceptedByUserId String?
  status           InvitationStatus @default(PENDING)
  expiresAt        DateTime
  acceptedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  centre           EcdCentre?       @relation(fields: [centreId], references: [id])
  invitedBy        User?            @relation("InvitationSender", fields: [invitedByUserId], references: [id])
  acceptedBy       User?            @relation("InvitationAcceptedUser", fields: [acceptedByUserId], references: [id])

  @@index([email, status])
  @@index([centreId, status])
}
